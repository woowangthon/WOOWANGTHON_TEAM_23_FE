<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_dim">

    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/card_margin"
        android:background="@drawable/card_background"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/card_logo"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_logo_mark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/ink_sub"
                android:textSize="@dimen/card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/card_type_ox"
                android:textColor="@color/brand"
                android:textSize="@dimen/card_label_size"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/card_text"
            android:textSize="@dimen/card_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_answer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card_o"
                android:layout_width="0dp"
                android:layout_height="@dimen/card_ox_height"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_btn_o"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/card_o"
                android:textColor="@color/brand"
                android:textSize="@dimen/card_ox_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_x"
                android:layout_width="0dp"
                android:layout_height="@dimen/card_ox_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_btn_x"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/card_x"
                android:textColor="@color/card_wrong"
                android:textSize="@dimen/card_ox_size"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_skip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_btn_text"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/card_skip"
            android:textColor="@color/ink_sub"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/card_result_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/card_result_icon"
                android:layout_width="@dimen/card_result_icon_size"
                android:layout_height="@dimen/card_result_icon_size"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/card_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_result_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/ink_sub"
                android:textSize="@dimen/card_detail_size" />

            <TextView
                android:id="@+id/card_confirm"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_button_height"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/card_confirm"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/card_timer"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_timer" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
